# Copy to backend/.env for local use (or set these in the Render dashboard)
DATABASE_URL=sqlite:///water.db           # Neon: postgresql://user:pass@host/db?sslmode=require
SECRET_KEY=change-this-to-a-long-random-string
CRON_KEY=change-this-too
GEMINI_API_KEY=                           # free key: https://aistudio.google.com  (optional)
GEMINI_MODEL=gemini-2.5-flash             # any free Gemini vision model listed in AI Studio
OPENWEATHER_API_KEY=                      # optional
RESPONSE_HOURS=48                         # hours before an un-inspected complaint escalates
GEO_TOLERANCE_M=300                       # inspection/completion photo must be within this distance
SEED_DEMO=true                            # set to false once you load real authorities/water bodies
DEVICE_NEAR_M=200                         # uploader's device must be within this distance of the photo's geotag
ALLOW_DEVICE_GPS_FALLBACK=false           # true = if a photo has no geotag, use the device GPS instead (demo/testing only)
